            "fillOpacity": 80,
            "gradientMode": "hue",
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "mode": "none" }
          }
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "Login Attempts Over Time",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({honeypot=\"cowrie\"} | json | eventid == \"cowrie.login.failed\" [$__interval]))",
          "legendFormat": "Failed",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({honeypot=\"cowrie\"} | json | eventid == \"cowrie.login.success\" [$__interval]))",
          "legendFormat": "Success",
          "queryType": "range",
          "refId": "B"
        }
      ]
    },
