# HoneyStack Environment Configuration
# Copy to .env and customize as needed

# Grafana
GRAFANA_ADMIN_PASSWORD=honeystack
GRAFANA_PORT=3000

# SSH
SSH_PORT=22222

# Cowrie
COWRIE_HOSTNAME=svr04

# Loki
LOKI_RETENTION=168h

# Log paths
LOG_DIR=/var/log/honeypots

# TLS (Grafana HTTPS)
GRAFANA_CERT_DIR=/opt/honeystack/certs

# GeoIP enrichment (auto-downloaded during install)
GEOIP_DIR=/opt/honeystack/geoip
GEOIP_ENABLED=false
